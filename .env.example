
NODE_ENV=development
# Puerto interno de la app dentro del contenedor (no cambiar)
PORT=3000
# Puerto externo publicado por Docker (puerta de acceso al servicio)
HOST_PORT=3000
MICROSOFT_APP_ID=
# Client secret del registro de la aplicación
MICROSOFT_APP_PASSWORD=
# Tenant ID (opcional, recomendado para bots de un solo tenant)
MICROSOFT_APP_TENANT_ID=
# Nombre público del bot
MICROSOFT_APP_NAME=Oberon360 Bot
# Alcance OAuth del bot hacia el canal (para mensajes proactivos)
BOT_FRAMEWORK_OAUTH_SCOPE=https://api.botframework.com
# URL global del servicio de Teams para mensajes proactivos (solo si no se tiene la de la actividad)
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/

# ---------- Microsoft Graph ----------
# Si se usa un registro de aplicación separado para Graph, especificar estos valores.
# Si se dejan vacíos, se reutilizan las credenciales del bot (MICROSOFT_APP_ID / MICROSOFT_APP_PASSWORD).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_AUTHORITY=https://login.microsoftonline.com
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_SCOPE=https://graph.microsoft.com/.default

# ---------- Aplicación de Teams (manifest) ----------
# "id" declarado en manifest/manifest.json (debe ser un GUID)
MANIFEST_APP_ID=
# Opcional: ID de catálogo de la app en Teams (se resuelve automáticamente vía Graph si se deja vacío)
TEAMS_APP_CATALOG_ID=

# ---------- Seguridad de la API ----------
# Clave requerida en el header "x-api-key" para consumir la API REST.
# Si se deja vacía, la API queda abierta (solo para desarrollo local).
API_KEY=

# ---------- Adjuntos ----------
# URL pública del bot (Teams la usa para cargar los adjuntos).
# Ej: https://bot-tuempresa.dominio.com
PUBLIC_BASE_URL=
# Carpeta local donde se almacenan temporalmente los adjuntos descargados.
FILE_STORAGE_DIR=./uploads
# Tamaño máximo de un adjunto en MB.
ATTACHMENT_MAX_SIZE_MB=20
# Horas de retención de los adjuntos antes de ser eliminados.
ATTACHMENT_TTL_HOURS=24
# Opcional: hosts permitidos para descargar adjuntos (separados por coma).
# Vacío = cualquier host http/https.
ATTACHMENT_ALLOWED_HOSTS=

# ---------- Base de datos (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=teams_bot
# En desarrollo crea/esquema automáticamente. En producción debe ser false.
DB_SYNCHRONIZE=true
DB_SSL=false
